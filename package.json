{
  "name": "astro-blog",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "check:encoding": "node scripts/check-text-encoding.mjs",
    "verify:production-source": "node scripts/verify-production-source.mjs",
    "build": "npm run check:encoding && astro build && node scripts/ensure-sitemap-xml.mjs",
    "postbuild": "node scripts/postbuild-sitemap.mjs",
    "brand:og": "node scripts/generate-og-image.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "indexnow:sitemap": "node scripts/indexnow.mjs sitemap",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "^3.7.0",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^7.1.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.18",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19"
  }
}
