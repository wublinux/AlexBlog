{
  "name": "alexblog-cms-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types && node scripts/normalize-generated-types.mjs",
    "check": "npm run types && tsc --noEmit",
    "test": "vitest run",
    "build": "npm run check && npm run test && wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^4.0.17",
    "wrangler": "^4.114.0"
  }
}
