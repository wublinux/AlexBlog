---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import BrandMark from '../components/BrandMark.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SakuraFaller from '../components/SakuraFaller.astro';
import MobileDrawer from '../components/MobileDrawer.astro';
import FloatingClouds from '../components/FloatingClouds.astro';
import PostCard from '../components/PostCard.astro';
import TerminalQuote from '../components/TerminalQuote.astro';
import InteractiveTerminal from '../components/InteractiveTerminal.astro';
import { GITHUB_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { buildWebsiteJsonLd } from '../utils/seo';

const BASE = import.meta.env.BASE_URL;
const websiteJsonLd = buildWebsiteJsonLd(Astro.site?.toString() ?? 'https://letsgogogogogo.pp.ua');
// Keep home preview aligned with list pagination size for consistent editorial cadence.
const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);

const HOME_WALLPAPER = `${BASE}image/home-hero-anime.webp`;
const WALLPAPER_API_URL = `${BASE}api/wallpaper`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${SITE_TITLE} - Tech, Notes & Life`}
			description="A personal blog about tech, notes, and life. 记录技术、笔记和生活。"
			jsonLd={websiteJsonLd}
		/>
	</head>
	<body>
		<FloatingClouds />
		<SakuraFaller density={0.45} heightVh={46} />
		<Header />
		<MobileDrawer />
		<main class="vt-page-main page-shell page-fade-in py-10 md:py-14">
			<div class="space-y-6">
				<section
					class="hero-enter overflow-hidden rounded-2xl border border-zinc-200 bg-white dark:border-zinc-700 dark:bg-zinc-900"
					data-hero-wallpaper-root
					data-wallpaper-api={WALLPAPER_API_URL}
				>
					<div class="relative aspect-[16/9] w-full overflow-hidden">
						<div data-parallax class="hero-kenburns relative h-full w-full will-change-transform">
							<img
								src={HOME_WALLPAPER}
								alt="日系春日房间、樱花与二次元人物组成的博客主视觉"
								width="1600"
								height="900"
								loading="eager"
								fetchpriority="high"
								data-hero-base-img
								class="h-full w-full object-cover object-center"
							/>
							<img
								alt=""
								width="1600"
								height="900"
								decoding="async"
								referrerpolicy="no-referrer"
								aria-hidden="true"
								data-hero-layer="0"
								class="hero-wallpaper-layer pointer-events-none absolute inset-0 h-full w-full object-cover object-[50%_28%]"
							/>
							<img
								alt=""
								width="1600"
								height="900"
								decoding="async"
								referrerpolicy="no-referrer"
								aria-hidden="true"
								data-hero-layer="1"
								class="hero-wallpaper-layer pointer-events-none absolute inset-0 h-full w-full object-cover object-[50%_28%]"
							/>
						</div>
						<div class="pointer-events-none absolute inset-0 bg-zinc-900/10 dark:bg-zinc-950/25"></div>
						<div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-zinc-950/40 to-transparent"></div>
						<div
							data-hero-wallpaper-hud
							class="absolute bottom-2.5 right-2.5 z-10 hidden max-w-[calc(100%-1.25rem)] items-center gap-1 rounded-full border border-white/15 bg-zinc-950/50 px-2 py-1 text-[11px] font-medium text-white/90 shadow-lg backdrop-blur-md transition-opacity duration-200 opacity-85 hover:opacity-100 sm:bottom-3 sm:right-3"
						>
							<a
								data-hero-wallpaper-source
								href="https://wallhaven.cc/"
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex min-w-0 items-center gap-1.5 rounded-full px-2 py-0.5 text-white/90 no-underline transition-colors hover:bg-white/15 hover:text-white"
								title="Wallhaven 纯二次元热榜 · 每 4 小时自动轮换"
							>
								<span class="h-1.5 w-1.5 shrink-0 rounded-full bg-rose-300" aria-hidden="true"></span>
								<span data-hero-wallpaper-label class="truncate">二次元热榜</span>
								<span data-hero-wallpaper-res class="hidden shrink-0 opacity-75 sm:inline"></span>
							</a>
							<span class="h-3 w-px shrink-0 bg-white/20" aria-hidden="true"></span>
							<button
								type="button"
								data-hero-wallpaper-next
								class="inline-flex shrink-0 items-center rounded-full px-2 py-0.5 text-white/90 transition-colors hover:bg-white/15 hover:text-white disabled:opacity-50"
								title="切换下一张二次元热榜壁纸"
							>
								换一张
							</button>
							<button
								type="button"
								data-hero-wallpaper-toggle
								class="inline-flex shrink-0 items-center rounded-full px-2 py-0.5 text-white/80 transition-colors hover:bg-white/15 hover:text-white"
								title="切换默认封面与 4 小时热榜轮换"
							>
								默认
							</button>
						</div>
					</div>
				</section>

				<section class="section-enter section-enter-delay-1 grid grid-cols-1 gap-6 items-start md:grid-cols-[minmax(0,1fr)_auto] md:items-center">
					<div class="hero-enter hero-enter-delay-2 max-w-[40rem]">
						<h1 class="vt-page-title brand-wordmark flex flex-wrap items-center gap-x-2.5 gap-y-1">
							<BrandMark class="h-[2.3rem] -ml-1 self-center md:h-[3.05rem]" />
							<span class="text-[2.55rem] leading-none text-zinc-900 dark:text-zinc-100 md:text-[3.4rem]">
								Alex<span class="brand-apostrophe">&rsquo;</span>s
							</span>
							<span class="text-[2.55rem] italic leading-none text-zinc-600 dark:text-zinc-300 md:text-[3.4rem]">
								Blog
							</span>
						</h1>
						<p class="mt-3 max-w-xl font-sans text-[15px] leading-7 text-zinc-500 dark:text-zinc-400">
							Notes on tech, life, and everything in between.
						</p>
						<div class="mt-3 flex flex-wrap items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.16em] text-zinc-400 dark:text-zinc-500">
							<span class="apple-meta-pill">
								<span class="apple-meta-pill-label">Tech</span>
							</span>
							<span class="apple-meta-pill">
								<span class="apple-meta-pill-label">Notes</span>
							</span>
							<span class="apple-meta-pill">
								<span class="apple-meta-pill-label">Life</span>
							</span>
						</div>
						<div class="mt-3.5 flex flex-wrap gap-2.5">
							<span class="inline-flex items-center rounded-full border border-zinc-200/85 bg-white/78 px-3 py-1.5 text-[11px] font-medium tracking-[0.01em] text-zinc-600 shadow-[0_8px_20px_rgba(15,23,42,0.04)] backdrop-blur-sm dark:border-zinc-700/80 dark:bg-zinc-900/72 dark:text-zinc-300">
								UI: English
							</span>
							<span class="inline-flex items-center rounded-full border border-zinc-200/85 bg-white/78 px-3 py-1.5 text-[11px] font-medium tracking-[0.01em] text-zinc-600 shadow-[0_8px_20px_rgba(15,23,42,0.04)] backdrop-blur-sm dark:border-zinc-700/80 dark:bg-zinc-900/72 dark:text-zinc-300">
								Content: Chinese (long-form)
							</span>
						</div>
						<div class="mt-3.5 flex items-center gap-2">
							<span
								data-easter-egg-trigger
								class="inline-flex items-center rounded-full border border-zinc-200/85 bg-white/78 px-3 py-1.5 text-[11px] font-medium tracking-[0.01em] text-zinc-400 shadow-[0_8px_20px_rgba(15,23,42,0.04)] backdrop-blur-sm dark:border-zinc-700/80 dark:bg-zinc-900/72 dark:text-zinc-500 cursor-default select-none"
								title="7.7"
							>
								7.7
							</span>
						</div>
					</div>

					<div class="hero-enter hero-enter-delay-2 w-full max-w-sm justify-self-end md:self-start">
						<TerminalQuote />
					</div>
				</section>

				<!-- Interactive Terminal Section -->
				<section class="hero-enter hero-enter-delay-2">
					<div class="max-w-md mx-auto">
						<InteractiveTerminal />
					</div>
				</section>

				<!-- Decorative pop-art ribbon spanning the full hero row width. -->
				<section class="hero-enter hero-enter-delay-2 -mt-1" aria-hidden="true">
					<div class="dots-band" data-dots-band>
						<canvas></canvas>
					</div>
				</section>
			</div>

			<section class="mt-10">
				<div class="mb-4 flex items-center justify-between" data-reveal>
					<h2 class="text-xl font-semibold tracking-tight">Latest Posts</h2>
					<a
						href={`${BASE}blog/`}
						class="apple-float-chip inline-flex items-center gap-1.5 rounded-xl border border-zinc-300/90 bg-zinc-50/96 px-3 py-1.5 text-sm font-medium text-zinc-700 no-underline dark:border-zinc-700/90 dark:bg-zinc-900/96 dark:text-zinc-300"
					>
						<span class="apple-float-label">
							<span>View all</span>
							<svg viewBox="0 0 20 20" class="h-4 w-4 opacity-75" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
								<path d="M4.75 10h10.5" stroke-linecap="round" />
								<path d="M10.75 5.5 15.25 10l-4.5 4.5" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</span>
					</a>
				</div>
				<ul class="grid gap-4 md:grid-cols-2">
					{
						posts.map((post, idx) => (
							<li class="relative" data-reveal style={`--reveal-delay: ${(idx % 2) * 80}ms`}>
								<PostCard
									post={post}
									base={BASE}
									titleTag="h3"
									titleClass="mt-2 text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-100"
									descriptionClass="mt-2 font-serif text-sm leading-7 text-zinc-600 dark:text-zinc-300"
									maxMobile={3}
									maxDesktop={3}
									reloadOnNavigate={true}
								/>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />

		<!-- Easter Egg: click "7.7" five times to reveal hidden content -->
		<div data-easter-egg-overlay class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/60 backdrop-blur-sm">
			<div class="relative max-w-lg mx-4 p-8 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 shadow-2xl text-center">
				<button data-easter-egg-close class="absolute top-3 right-3 text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-200 transition-colors">
					<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"/></svg>
				</button>
				<div data-easter-egg-content class="font-serif text-zinc-700 dark:text-zinc-200 leading-relaxed"></div>
			</div>
		</div>

		<script>
			(() => {
				/*
				 * Easter egg: click the "7.7" badge 5 times to reveal hidden content.
				 */
				const win = window as any;
				const initEasterEgg = () => {
					const trigger = document.querySelector('[data-easter-egg-trigger]');
					const overlay = document.querySelector('[data-easter-egg-overlay]');
					const content = document.querySelector('[data-easter-egg-content]');
					const closeBtn = document.querySelector('[data-easter-egg-close]');
					if (!trigger || !overlay || !content || !closeBtn) return;
					if (trigger.dataset.bound === 'true') return;
					trigger.dataset.bound = 'true';

					let clickCount = 0;
					let clickTimer = null;

					trigger.addEventListener('click', () => {
						clickCount++;
						if (clickTimer) clearTimeout(clickTimer);
						clickTimer = setTimeout(() => { clickCount = 0; }, 2000);

						if (clickCount >= 5) {
							clickCount = 0;
							showEasterEgg();
						}
					});

					const showEasterEgg = async () => {
						try {
							const base = document.querySelector('base')?.getAttribute('href') || '/';
							const res = await fetch(`${base}easter-egg/content.html`);
							if (res.ok) {
								content.innerHTML = await res.text();
							} else {
								content.innerHTML = '<p class="text-lg">You found the secret! ✨</p><p class="mt-2 text-sm text-zinc-500">Place your easter egg content in <code>public/easter-egg/content.html</code></p>';
							}
						} catch {
							content.innerHTML = '<p class="text-lg">You found the secret! ✨</p>';
						}
						overlay.classList.remove('hidden');
						overlay.classList.add('flex');
					};

					closeBtn.addEventListener('click', () => {
						overlay.classList.add('hidden');
						overlay.classList.remove('flex');
					});

					overlay.addEventListener('click', (e) => {
						if (e.target === overlay) {
							overlay.classList.add('hidden');
							overlay.classList.remove('flex');
						}
					});
				};

				window.__easterEggInit = initEasterEgg;
				if (!window.__easterEggPageLoadBound) {
					window.__easterEggPageLoadBound = true;
					document.addEventListener('astro:page-load', () => {
						if (typeof window.__easterEggInit === 'function') window.__easterEggInit();
					});
				}
				initEasterEgg();
			})();
		</script>

		<script>
			(() => {
				/*
				 * Scroll parallax for hero image.
				 * Translates the image slightly as user scrolls for depth effect.
				 */
				const initParallax = () => {
					const img = document.querySelector('[data-parallax]');
					if (!img) return;

					const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
					if (reducedMotion) return;

					let ticking = false;

					const onScroll = () => {
						if (ticking) return;
						ticking = true;
						requestAnimationFrame(() => {
							const rect = img.getBoundingClientRect();
							const viewH = window.innerHeight;
							// Only apply when hero is in viewport; bound travel within 3% scale bleed so edges never gap.
							if (rect.bottom > 0 && rect.top < viewH) {
								const progress = (viewH - rect.top) / (viewH + rect.height);
								const maxTravel = Math.min(20, rect.height * 0.024);
								const offset = (progress - 0.5) * maxTravel;
								img.style.transform = `translateY(${offset.toFixed(2)}px) scale(1.03)`;
							}
							ticking = false;
						});
					};

					window.addEventListener('scroll', onScroll, { passive: true });
					onScroll();

					const cleanup = () => {
						window.removeEventListener('scroll', onScroll);
						img.style.transform = '';
					};

					document.addEventListener('astro:before-swap', cleanup, { once: true });
				};

				window.__parallaxInit = initParallax;
				if (!window.__parallaxPageLoadBound) {
					window.__parallaxPageLoadBound = true;
					document.addEventListener('astro:page-load', () => {
						if (typeof window.__parallaxInit === 'function') window.__parallaxInit();
					});
				}
				initParallax();
			})();
		</script>

		<script>
			(() => {
				type WallpaperItem = {
					rank: number;
					id: string;
					imageUrl: string;
					pageUrl: string;
					resolution: string;
					favorites: number;
				};

				type WallpaperPayload = {
					rotationHours: number;
					slot: number;
					activeIndex: number;
					nextChangeAt: string;
					active: WallpaperItem;
					items: WallpaperItem[];
				};

				type WallpaperPref =
					| { mode: 'auto' }
					| { mode: 'default' }
					| { mode: 'manual'; slot: number; index: number };

				const PREF_KEY = 'alexblog:hero-wallpaper-pref:v1';
				const ROTATION_MS = 4 * 60 * 60 * 1_000;
				const CACHE_TTL_MS = 5 * 60 * 1_000;
				const win = window as any;

				const safeWallhavenUrl = (value: unknown, expectedHost: 'w.wallhaven.cc' | 'wallhaven.cc') => {
					if (typeof value !== 'string') return null;
					try {
						const parsed = new URL(value);
						if (parsed.protocol !== 'https:' || parsed.hostname !== expectedHost) return null;
						return parsed.href;
					} catch {
						return null;
					}
				};

				const readPref = (): WallpaperPref => {
					try {
						const raw = localStorage.getItem(PREF_KEY);
						if (!raw) return { mode: 'auto' };
						const parsed = JSON.parse(raw) as Partial<WallpaperPref>;
						if (parsed.mode === 'default') return { mode: 'default' };
						if (
							parsed.mode === 'manual' &&
							typeof parsed.slot === 'number' &&
							Number.isInteger(parsed.slot) &&
							typeof parsed.index === 'number' &&
							Number.isInteger(parsed.index) &&
							parsed.index >= 0
						) {
							return { mode: 'manual', slot: parsed.slot, index: parsed.index };
						}
					} catch {
						// Ignore storage unavailability
					}
					return { mode: 'auto' };
				};

				const writePref = (pref: WallpaperPref) => {
					try {
						if (pref.mode === 'auto') localStorage.removeItem(PREF_KEY);
						else localStorage.setItem(PREF_KEY, JSON.stringify(pref));
					} catch {
						// Ignore storage unavailability
					}
				};

				const formatNextTime = (iso: string) => {
					const date = new Date(iso);
					if (!Number.isFinite(date.getTime())) return '';
					return new Intl.DateTimeFormat('zh-CN', {
						hour: '2-digit',
						minute: '2-digit',
						hour12: false,
					}).format(date);
				};

				const computeSlot = (count: number) => {
					const now = Date.now();
					const slot = Math.floor(now / ROTATION_MS);
					const activeIndex = ((slot % count) + count) % count;
					const nextChangeMs = (slot + 1) * ROTATION_MS;
					return {
						slot,
						activeIndex,
						nextChangeMs,
						nextChangeAt: new Date(nextChangeMs).toISOString(),
					};
				};

				const preloadImage = (url: string) =>
					new Promise<void>((resolve, reject) => {
						const loader = new Image();
						loader.referrerPolicy = 'no-referrer';
						loader.decoding = 'async';
						loader.onload = () => {
							if (typeof loader.decode === 'function') {
								loader.decode().then(resolve, resolve);
							} else {
								resolve();
							}
						};
						loader.onerror = () => reject(new Error('wallpaper_load_failed'));
						loader.src = url;
					});

				const initHeroWallpaper = () => {
					const root = document.querySelector<HTMLElement>('[data-hero-wallpaper-root]');
					if (!root || root.dataset.bound === 'true') return;
					root.dataset.bound = 'true';

					const apiUrl = root.dataset.wallpaperApi;
					const layer0 = root.querySelector<HTMLImageElement>('[data-hero-layer="0"]');
					const layer1 = root.querySelector<HTMLImageElement>('[data-hero-layer="1"]');
					const hud = root.querySelector<HTMLElement>('[data-hero-wallpaper-hud]');
					const sourceLink = root.querySelector<HTMLAnchorElement>('[data-hero-wallpaper-source]');
					const labelEl = root.querySelector<HTMLElement>('[data-hero-wallpaper-label]');
					const resEl = root.querySelector<HTMLElement>('[data-hero-wallpaper-res]');
					const nextBtn = root.querySelector<HTMLButtonElement>('[data-hero-wallpaper-next]');
					const toggleBtn = root.querySelector<HTMLButtonElement>('[data-hero-wallpaper-toggle]');
					if (!apiUrl || !layer0 || !layer1 || !hud || !sourceLink || !labelEl || !nextBtn || !toggleBtn) {
						return;
					}

					const layers = [layer0, layer1];
					let activeLayer = -1;
					let payload: WallpaperPayload | null = null;
					let currentIndex = -1;
					let showingDefault = true;
					let renderToken = 0;
					let destroyed = false;
					let rotationTimer: number | null = null;
					const abortController = new AbortController();

					const clearRotationTimer = () => {
						if (rotationTimer !== null) {
							window.clearTimeout(rotationTimer);
							rotationTimer = null;
						}
					};

					const showDefaultLayer = () => {
						renderToken += 1;
						showingDefault = true;
						activeLayer = -1;
						for (const layer of layers) {
							layer.classList.remove('is-visible');
							layer.setAttribute('aria-hidden', 'true');
						}
						if (payload) {
							const slotInfo = computeSlot(payload.items.length);
							const nextClock = formatNextTime(slotInfo.nextChangeAt);
							labelEl.textContent = '默认封面';
							if (resEl) resEl.textContent = '';
							sourceLink.href = 'https://wallhaven.cc/';
							sourceLink.title = nextClock
								? `已固定默认封面 · 热榜每 4 小时轮换（下档 ${nextClock}）`
								: '已固定默认封面';
							toggleBtn.textContent = '热榜';
							toggleBtn.title = '恢复每 4 小时二次元热榜自动轮换';
						}
					};

					const showWallpaperAt = async (index: number, isManual = false): Promise<boolean> => {
						if (!payload || !payload.items.length || destroyed) return false;
						const count = payload.items.length;
						const safeIndex = ((index % count) + count) % count;
						const item = payload.items[safeIndex];
						if (!item) return false;

						const imageUrl = safeWallhavenUrl(item.imageUrl, 'w.wallhaven.cc');
						const pageUrl = safeWallhavenUrl(item.pageUrl, 'wallhaven.cc');
						if (!imageUrl || !pageUrl) return false;

						const token = ++renderToken;
						nextBtn.disabled = true;
						try {
							await preloadImage(imageUrl);
							if (destroyed || token !== renderToken) return false;

							const targetIdx = activeLayer === 0 ? 1 : 0;
							const targetLayer = layers[targetIdx];
							const prevLayer = activeLayer >= 0 ? layers[activeLayer] : null;

							targetLayer.src = imageUrl;
							targetLayer.alt = `Wallhaven 二次元热榜壁纸 #${item.rank} (${item.resolution})`;
							targetLayer.removeAttribute('aria-hidden');

							requestAnimationFrame(() => {
								if (destroyed || token !== renderToken) return;
								targetLayer.classList.add('is-visible');
								if (prevLayer && prevLayer !== targetLayer) {
									prevLayer.classList.remove('is-visible');
									prevLayer.setAttribute('aria-hidden', 'true');
								}
							});

							activeLayer = targetIdx;
							currentIndex = safeIndex;
							showingDefault = false;

							const slotInfo = computeSlot(count);
							const nextClock = formatNextTime(slotInfo.nextChangeAt);
							labelEl.textContent = `热榜 #${item.rank}`;
							if (resEl) resEl.textContent = `· ${item.resolution.replace('x', '×')}`;
							sourceLink.href = pageUrl;
							sourceLink.title = nextClock
								? `Wallhaven 纯二次元热榜（${isManual ? '手动切换，' : ''}下次自动轮换 ${nextClock}）`
								: 'Wallhaven 纯二次元热榜 · 点击查看原图';
							toggleBtn.textContent = '默认';
							toggleBtn.title = '切回默认静态封面';
							return true;
						} catch {
							return false;
						} finally {
							if (!destroyed && token === renderToken) {
								nextBtn.disabled = false;
							}
						}
					};

					const scheduleNextSlot = () => {
						clearRotationTimer();
						if (!payload || !payload.items.length || destroyed) return;
						const slotInfo = computeSlot(payload.items.length);
						const delayMs = Math.max(1_000, Math.min(slotInfo.nextChangeMs - Date.now() + 500, ROTATION_MS));
						rotationTimer = window.setTimeout(() => {
							if (destroyed) return;
							void loadPool(true);
						}, delayMs);
					};

					const applyFromPayload = async (data: WallpaperPayload) => {
						payload = data;
						hud.classList.remove('hidden');
						hud.classList.add('inline-flex');

						const slotInfo = computeSlot(data.items.length);
						const pref = readPref();
						if (pref.mode === 'default') {
							showDefaultLayer();
							scheduleNextSlot();
							return;
						}

						let targetIndex = slotInfo.activeIndex;
						let isManual = false;
						if (pref.mode === 'manual' && pref.slot === slotInfo.slot) {
							targetIndex = pref.index % data.items.length;
							isManual = true;
						} else if (pref.mode === 'manual') {
							// Slot advanced past the user's manual pick: resume automatic 4h rotation.
							writePref({ mode: 'auto' });
						}

						const ok = await showWallpaperAt(targetIndex, isManual);
						if (!ok && data.items.length > 1) {
							await showWallpaperAt((targetIndex + 1) % data.items.length, false);
						}
						scheduleNextSlot();
					};

					const fetchPool = async (forceFresh = false): Promise<WallpaperPayload | null> => {
						const cached = win.__heroWallpaperCache as
							| { fetchedAt: number; slot: number; data: WallpaperPayload }
							| undefined;
						const nowSlot = Math.floor(Date.now() / ROTATION_MS);
						if (
							!forceFresh &&
							cached &&
							cached.slot === nowSlot &&
							Date.now() - cached.fetchedAt < CACHE_TTL_MS
						) {
							return cached.data;
						}

						const response = await fetch(apiUrl, {
							headers: { Accept: 'application/json' },
							signal: abortController.signal,
						});
						if (!response.ok) return null;
						const data = (await response.json()) as WallpaperPayload;
						if (!data || !Array.isArray(data.items) || data.items.length === 0) return null;

						win.__heroWallpaperCache = {
							fetchedAt: Date.now(),
							slot: nowSlot,
							data,
						};
						return data;
					};

					const loadPool = async (forceFresh = false) => {
						try {
							const data = await fetchPool(forceFresh);
							if (!data || destroyed) return;
							await applyFromPayload(data);
						} catch {
							// Silently keep the local default hero illustration on offline/local preview.
						}
					};

					nextBtn.addEventListener('click', async () => {
						if (!payload || !payload.items.length) return;
						const count = payload.items.length;
						const slotInfo = computeSlot(count);
						const startIdx = showingDefault ? slotInfo.activeIndex : (currentIndex + 1) % count;
						const attempts = Math.min(3, count);
						for (let offset = 0; offset < attempts; offset += 1) {
							const candidateIdx = (startIdx + offset) % count;
							const ok = await showWallpaperAt(candidateIdx, true);
							if (ok) {
								writePref({ mode: 'manual', slot: slotInfo.slot, index: candidateIdx });
								return;
							}
						}
					});

					toggleBtn.addEventListener('click', async () => {
						if (!payload || !payload.items.length) return;
						if (showingDefault) {
							writePref({ mode: 'auto' });
							const slotInfo = computeSlot(payload.items.length);
							await showWallpaperAt(slotInfo.activeIndex, false);
						} else {
							writePref({ mode: 'default' });
							showDefaultLayer();
						}
					});

					const cleanup = () => {
						destroyed = true;
						clearRotationTimer();
						abortController.abort();
					};

					document.addEventListener('astro:before-swap', cleanup, { once: true });
					void loadPool(false);
				};

				win.__heroWallpaperInit = initHeroWallpaper;
				if (!win.__heroWallpaperPageLoadBound) {
					win.__heroWallpaperPageLoadBound = true;
					document.addEventListener('astro:page-load', () => {
						if (typeof win.__heroWallpaperInit === 'function') win.__heroWallpaperInit();
					});
				}
				initHeroWallpaper();
			})();
		</script>

		<script>
			(() => {
				/*
				 * Pop-art dot ribbon: a drifting halftone wave on <canvas>.
				 * Gold dots with sparse blue accents and hollow rings; brightness and
				 * size follow two layered sine waves so the band reads as a slow,
				 * left-to-right current with twinkling crests.
				 * Pauses off-screen / in hidden tabs; reduced motion gets one static frame.
				 */
				const initDotsBand = () => {
					const wrap = document.querySelector('[data-dots-band]');
					if (!wrap || wrap.dataset.bound === 'true') return;
					wrap.dataset.bound = 'true';

					const canvas = wrap.querySelector('canvas');
					const ctx = canvas?.getContext('2d');
					if (!ctx) return;

					const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
					const SPACING = 17;
					const ROWS = 3;

					let width = 0;
					let height = 0;
					let dots = [];

					const build = () => {
						const dpr = Math.min(window.devicePixelRatio || 1, 2);
						const rect = wrap.getBoundingClientRect();
						width = rect.width;
						height = rect.height;
						canvas.width = Math.max(1, Math.round(width * dpr));
						canvas.height = Math.max(1, Math.round(height * dpr));
						ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

						dots = [];
						const cols = Math.ceil(width / SPACING) + 1;
						for (let c = 0; c < cols; c++) {
							for (let r = 0; r < ROWS; r++) {
								dots.push({
									x: c * SPACING,
									row: r,
									phase: Math.random() * Math.PI * 2,
									twinkle: 0.6 + Math.random() * 0.9,
									accent: Math.random() < 0.055,
									ring: Math.random() < 0.075,
								});
							}
						}
					};

					let t = Math.random() * 100;
					let rafId = 0;
					let running = false;

					const draw = () => {
						ctx.clearRect(0, 0, width, height);
						const dark = document.documentElement.classList.contains('dark');
						const base = dark ? '255, 209, 220' : '255, 143, 171';
						const accent = dark ? '196, 167, 231' : '147, 130, 220';
						const rowGap = height / (ROWS + 1);

						for (const d of dots) {
							// Primary wave travels right; the slower secondary wave breaks uniformity.
							const wave = Math.sin(d.x * 0.018 - t * 1.55 + d.row * 0.85);
							const drift = Math.sin(d.x * 0.0065 + t * 0.6 + d.phase);
							const y = rowGap * (d.row + 1) + wave * 7 + drift * 3;
							const crest = (wave + 1) / 2;
							const pulse = (Math.sin(t * d.twinkle * 2 + d.phase) + 1) / 2;
							const alpha = 0.07 + crest * 0.3 + pulse * 0.22 * crest;
							const radius = 1.05 + crest * 1.25 + pulse * 0.65;
							const rgb = d.accent ? accent : base;

							if (d.ring) {
								ctx.strokeStyle = `rgba(${rgb}, ${Math.min(alpha * 1.15, 0.6)})`;
								ctx.lineWidth = 1;
								ctx.beginPath();
								ctx.arc(d.x, y, radius + 1.4, 0, Math.PI * 2);
								ctx.stroke();
							} else {
								ctx.fillStyle = `rgba(${rgb}, ${alpha})`;
								ctx.beginPath();
								ctx.arc(d.x, y, radius, 0, Math.PI * 2);
								ctx.fill();
							}
						}
					};

					const tick = () => {
						t += 0.016;
						draw();
						rafId = requestAnimationFrame(tick);
					};

					let destroyed = false;
					let inView = true;
					const start = () => {
						if (running || destroyed || reducedMotion) return;
						running = true;
						rafId = requestAnimationFrame(tick);
					};
					const stop = () => {
						running = false;
						if (rafId) cancelAnimationFrame(rafId);
						rafId = 0;
					};

					let resizeRaf = 0;
					let io = null;
					const onVisibility = () => {
						if (document.hidden || !inView) stop();
						else start();
					};
					const onResize = () => {
						if (resizeRaf) return;
						resizeRaf = requestAnimationFrame(() => {
							resizeRaf = 0;
							build();
							draw();
						});
					};

					// Full teardown so route swaps and tab switches can never revive a
					// loop that draws to a detached canvas.
					const destroy = () => {
						destroyed = true;
						stop();
						if (resizeRaf) cancelAnimationFrame(resizeRaf);
						resizeRaf = 0;
						if (io) io.disconnect();
						document.removeEventListener('visibilitychange', onVisibility);
						window.removeEventListener('resize', onResize);
						document.removeEventListener('astro:before-swap', destroy);
					};

					// Replace any instance left over from a previous route.
					if (typeof window.__dotsBandDestroy === 'function') window.__dotsBandDestroy();
					window.__dotsBandDestroy = destroy;

					build();
					draw();

					if (!reducedMotion) {
						io = new IntersectionObserver((entries) => {
							for (const entry of entries) {
								inView = entry.isIntersecting;
								if (inView && !document.hidden) start();
								else stop();
							}
						});
						io.observe(wrap);
						document.addEventListener('visibilitychange', onVisibility);
					}

					window.addEventListener('resize', onResize);
					document.addEventListener('astro:before-swap', destroy);
				};

				// Keep exactly one document-level page-load hook no matter how many times
				// this inline script re-executes across View Transition navigations.
				window.__dotsBandInit = initDotsBand;
				if (!window.__dotsBandPageLoadBound) {
					window.__dotsBandPageLoadBound = true;
					document.addEventListener('astro:page-load', () => {
						if (typeof window.__dotsBandInit === 'function') window.__dotsBandInit();
					});
				}
				initDotsBand();
			})();
		</script>
	</body>
</html>
