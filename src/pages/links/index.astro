---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import MeteorShower from '../../components/MeteorShower.astro';
import MobileDrawer from '../../components/MobileDrawer.astro';
import PageHeading from '../../components/PageHeading.astro';
import { SITE_TITLE } from '../../consts';
import { links } from '../../data/links';
import { githubProjects } from '../../data/projects';

const MAX_TAGS = 3;
const FRIENDS_PAGE_SIZE = 9;
const base = import.meta.env.BASE_URL || '/';
const withBase = (p: string) => `${base.replace(/\/$/, '')}/${String(p).replace(/^\//, '')}`;

const friendLinks = links.sort((a, b) => {
	const order = { github: 0, bilibili: 1 } as const;
	return order[a.kind] - order[b.kind];
});
const friendPageCount = Math.max(1, Math.ceil(friendLinks.length / FRIENDS_PAGE_SIZE));
const friendPages = Array.from({ length: friendPageCount }, (_, index) =>
	friendLinks.slice(index * FRIENDS_PAGE_SIZE, (index + 1) * FRIENDS_PAGE_SIZE)
);
const friendPagesFilled = friendPages;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Projects & Friends | ${SITE_TITLE}`} description="Live GitHub projects, selected tools, and developers whose work I follow." />
	</head>
	<body>
		<MeteorShower density={0.5} heightVh={42} />
		<Header />
		<MobileDrawer />
		<main class="mx-auto flex max-w-6xl flex-col px-4 py-12" transition:name="page-main" transition:animate="fade">
			<PageHeading
				eyebrow="GitHub"
				title="Projects"
				accent="& Friends"
				subtitle="Live project activity from GitHub, followed by people whose work I value."
			/>

			<section class="order-3 mt-14">
				<div class="flex items-center justify-between gap-4">
					<h2 class="flex items-center gap-2.5 text-sm font-semibold uppercase tracking-[0.18em] text-zinc-500 dark:text-zinc-400">
						<span class="h-px w-6 bg-gradient-to-r from-[rgb(180,126,36)] to-transparent dark:from-[rgb(226,190,110)]"></span>
						Friends
					</h2>
					<div class:list={[
						'friends-pager inline-flex items-center gap-2 rounded-2xl border border-zinc-200/80 bg-white/80 p-1.5 shadow-[0_8px_24px_rgba(15,23,42,0.06)] backdrop-blur-md dark:border-zinc-800/80 dark:bg-zinc-950/70',
						friendPageCount <= 1 && 'hidden',
					]}>
						<button
							type="button"
							class="friends-pager-button inline-flex h-10 min-w-[72px] items-center justify-center rounded-xl px-3.5 text-sm font-medium text-zinc-700 transition-all duration-220 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:bg-zinc-100/85 hover:text-zinc-900 hover:shadow-sm dark:text-zinc-200 dark:hover:bg-zinc-800/85 is-hidden"
							data-friends-prev
							aria-label="Previous friends page"
						>
							Prev
						</button>
						<span class="friends-pager-status min-w-[56px] text-center text-sm font-medium text-zinc-500 dark:text-zinc-400" data-friends-pagination-status>1 / {friendPageCount}</span>
						<button
							type="button"
							class="friends-pager-button inline-flex h-10 min-w-[72px] items-center justify-center rounded-xl px-3.5 text-sm font-medium text-zinc-700 transition-all duration-220 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:bg-zinc-100/85 hover:text-zinc-900 hover:shadow-sm dark:text-zinc-200 dark:hover:bg-zinc-800/85"
							data-friends-next
							aria-label="Next friends page"
						>
							Next
						</button>
					</div>
				</div>
				<div class="mt-4">
					<div
						class="grid grid-cols-1 gap-6 opacity-100 transition-[opacity,transform] duration-200 ease-[cubic-bezier(0.22,1,0.36,1)] sm:grid-cols-2 lg:grid-cols-3"
						data-friends-grid
					>
					</div>
					<div class="hidden" data-friends-pages-store>
						{
							friendPagesFilled.map((pageItems, pageIndex) => (
								<div data-friends-store-page={pageIndex}>
									{
										pageItems.map((item) => {
											const tags = item.tags ?? [];
											const shown = tags.slice(0, MAX_TAGS);
											const more = Math.max(tags.length - shown.length, 0);
											const firstLetter = item.name.trim().charAt(0).toUpperCase() || 'L';
											const githubAvatar = item.github ? `https://github.com/${item.github}.png?size=160` : null;
											const avatarSrc = item.avatar
  ? (item.avatar.startsWith('http://') || item.avatar.startsWith('https://'))
    ? item.avatar
    : withBase(item.avatar)
  : githubAvatar;

											return (
												<article class="card-spotlight group relative min-h-[210px] rounded-2xl border border-zinc-200 bg-white/90 p-5 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-zinc-300 hover:shadow-md dark:border-zinc-800 dark:bg-zinc-950/80 dark:hover:border-zinc-600">
													<div class="flex items-start justify-between gap-3">
														<div class="flex items-center gap-3">
															{avatarSrc ? (
																<img
																	src={avatarSrc}
																	alt={`${item.name} avatar`}
																	class="h-11 w-11 rounded-full border border-zinc-200 object-cover dark:border-zinc-700"
																	loading="lazy"
																/>
															) : (
																<span class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-zinc-200 bg-zinc-100 text-sm font-semibold text-zinc-700 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200">
																	{firstLetter}
																</span>
															)}
															<div>
																<h3 class="text-base font-semibold text-zinc-900 dark:text-zinc-100">{item.name}</h3>
															</div>
														</div>
														<div class="flex items-center gap-2">
															{item.bilibili && (
																<a
																	href={item.bilibili}
																	target="_blank"
																	rel="noreferrer"
																	class="icon-button inline-flex h-8 w-8 items-center justify-center rounded-xl border border-zinc-200 text-zinc-600 transition-colors hover:border-zinc-400 hover:text-zinc-900 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-zinc-500 dark:hover:text-zinc-100"
																	aria-label={`${item.name} Bilibili`}
																>
																	<svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
																		<path d="M7.4 2.8a1 1 0 0 1 1.4 0L12 6l3.2-3.2a1 1 0 1 1 1.4 1.4L14.5 6.3h3.8A3.7 3.7 0 0 1 22 10v8.3A3.7 3.7 0 0 1 18.3 22H5.7A3.7 3.7 0 0 1 2 18.3V10a3.7 3.7 0 0 1 3.7-3.7h3.8L7.4 4.2a1 1 0 0 1 0-1.4ZM5.7 8.3A1.7 1.7 0 0 0 4 10v8.3c0 .9.8 1.7 1.7 1.7h12.6c.9 0 1.7-.8 1.7-1.7V10c0-.9-.8-1.7-1.7-1.7H5.7Zm1.8 3a1 1 0 0 1 1 1v3.4a1 1 0 1 1-2 0v-3.4a1 1 0 0 1 1-1Zm9 0a1 1 0 0 1 1 1v3.4a1 1 0 1 1-2 0v-3.4a1 1 0 0 1 1-1Z" />
																	</svg>
																	<span class="sr-only">Bilibili</span>
																</a>
															)}
											{item.url && (
												<a
													href={item.url}
													target="_blank"
													rel="noreferrer"
													class="apple-visit-button inline-flex items-center rounded-xl border border-zinc-200/70 bg-white/56 px-2.5 py-1.5 text-xs font-medium text-zinc-700 no-underline backdrop-blur-sm dark:border-zinc-700/75 dark:bg-zinc-950/36 dark:text-zinc-200"
												>
													<span class="apple-visit-label">
														<span>Visit</span>
														<span class="apple-visit-emoji" aria-hidden="true">↗</span>
													</span>
												</a>
											)}
														</div>
													</div>

													{item.description && (
														<p class="friends-desc-clamp mt-4 text-sm leading-6 text-zinc-600 dark:text-zinc-300">{item.description}</p>
													)}

													{tags.length > 0 && (
														<div class="mt-4 flex flex-wrap gap-1.5">
															{shown.map((tag) => (
																<span class="inline-flex items-center rounded-full bg-zinc-100 px-2 py-0.5 text-xs text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
																	{tag}
																</span>
															))}
															{more > 0 && (
																<span class="inline-flex items-center rounded-full bg-zinc-100 px-2 py-0.5 text-xs text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
																	+{more}
																</span>
															)}
														</div>
													)}
												</article>
											);
										})
									}
								</div>
							))
						}
					</div>
				</div>
			</section>

			<section id="projects" class="order-2 mt-8 scroll-mt-24 section-enter section-enter-delay-1">
				<div class="mb-4">
					<h2 class="flex items-center gap-2.5 text-sm font-semibold uppercase tracking-[0.18em] text-zinc-500 dark:text-zinc-400">
						<span class="h-px w-6 bg-gradient-to-r from-[rgb(180,126,36)] to-transparent dark:from-[rgb(226,190,110)]"></span>
						Projects
					</h2>
					<p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">Live from GitHub — all public repositories.</p>
				</div>
				<div class="mt-4 grid grid-cols-1 gap-6 sm:grid-cols-2" data-github-projects>
					{
						githubProjects.map((project, idx) => {
							const repositoryUrl = `https://github.com/${project.owner}/${project.repo}`;
							return (
								<article
									data-reveal
									data-project-owner={project.owner}
									data-project-repo={project.repo}
									style={`--reveal-delay: ${(idx % 2) * 70}ms`}
									class="card-spotlight group relative flex min-h-[260px] flex-col rounded-2xl border border-zinc-200 bg-white/95 p-6 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-zinc-300 hover:shadow-md dark:border-zinc-800 dark:bg-zinc-950/85 dark:hover:border-zinc-600"
								>
									<div class="flex items-start justify-between gap-3">
										<div class="flex items-center gap-3">
											<span class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-zinc-200 bg-zinc-100 text-zinc-700 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200">
												<svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.24c-3.23.7-3.91-1.37-3.91-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.26 3.38.97.1-.75.4-1.27.74-1.56-2.58-.3-5.29-1.29-5.29-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.47.11-3.05 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.4-2.72 5.38-5.3 5.67.42.36.79 1.06.79 2.14v3.17c0 .31.21.67.79.56A11.5 11.5 0 0 0 12 .7Z" /></svg>
											</span>
											<h3 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100" data-project-name>{project.displayName}</h3>
										</div>
										<span class="rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-[11px] font-medium text-emerald-700 dark:border-emerald-900 dark:bg-emerald-950/50 dark:text-emerald-300" data-project-sync-status>Configured</span>
									</div>

									<p class="mt-4 flex-1 text-sm leading-6 text-zinc-600 dark:text-zinc-300" data-project-description>{project.fallbackDescription}</p>

									<div class="mt-4 flex flex-wrap gap-2" data-project-tags>
										{project.fallbackTags.slice(0, MAX_TAGS).map((tag) => (
											<span class="inline-flex items-center rounded-md bg-zinc-100 px-2 py-1 text-xs text-zinc-600 dark:bg-zinc-900 dark:text-zinc-300">
													{tag}
												</span>
										))}
									</div>

									<div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-zinc-100 pt-4 text-xs text-zinc-500 dark:border-zinc-800 dark:text-zinc-400">
										<div class="flex items-center gap-3" aria-label="GitHub repository statistics">
											<span>★ <span data-project-stars>0</span></span>
											<span>⑂ <span data-project-forks>0</span></span>
											<span data-project-updated>Live metadata pending</span>
										</div>
										<div class="flex items-center gap-2">
											<a href={repositoryUrl} target="_blank" rel="noreferrer" class="font-medium text-zinc-700 no-underline hover:text-[rgb(180,126,36)] dark:text-zinc-200 dark:hover:text-[rgb(226,190,110)]" data-project-repository>Repository ↗</a>
											<a href={repositoryUrl} target="_blank" rel="noreferrer" class="hidden font-medium text-zinc-700 no-underline hover:text-[rgb(180,126,36)] dark:text-zinc-200 dark:hover:text-[rgb(226,190,110)]" data-project-homepage>Website ↗</a>
										</div>
									</div>
								</article>
							);
						})
					}
				</div>
			</section>
		</main>
		<Footer />
		<script>
			type GitHubRepository = {
				name?: string;
				html_url?: string;
				homepage?: string | null;
				description?: string | null;
				language?: string | null;
				stargazers_count?: number;
				forks_count?: number;
				updated_at?: string | null;
				fork?: boolean;
				archived?: boolean;
			};

			const GITHUB_PROJECTS_CACHE_KEY = 'alexblog:github-projects:v1';
			const GITHUB_PROJECTS_CACHE_TTL = 5 * 60 * 1000;

			function readProjectCache(): GitHubRepository[] | null {
				try {
					const raw = sessionStorage.getItem(GITHUB_PROJECTS_CACHE_KEY);
					if (!raw) return null;
					const cached = JSON.parse(raw) as { savedAt?: number; repositories?: GitHubRepository[] };
					if (!cached.savedAt || Date.now() - cached.savedAt > GITHUB_PROJECTS_CACHE_TTL) return null;
					return Array.isArray(cached.repositories) ? cached.repositories : null;
				} catch {
					return null;
				}
			}

			function writeProjectCache(repositories: GitHubRepository[]) {
				try {
					sessionStorage.setItem(
						GITHUB_PROJECTS_CACHE_KEY,
						JSON.stringify({ savedAt: Date.now(), repositories })
					);
				} catch {
					// Storage can be disabled; live data still renders for this visit.
				}
			}

			function safeExternalUrl(value: string | null | undefined): string | null {
				if (!value) return null;
				try {
					const url = new URL(value);
					return url.protocol === 'https:' || url.protocol === 'http:' ? url.href : null;
				} catch {
					return null;
				}
			}

			function applyGitHubProjects(repositories: GitHubRepository[], source: 'live' | 'cache') {
				const byName = new Map(
					repositories
						.filter((repo) => !repo.fork && !repo.archived && typeof repo.name === 'string')
						.map((repo) => [repo.name!.toLowerCase(), repo])
				);

				// Update existing static cards
				document.querySelectorAll<HTMLElement>('[data-project-repo]').forEach((card) => {
					const repoName = card.dataset.projectRepo?.toLowerCase();
					const repo = repoName ? byName.get(repoName) : undefined;
					if (!repo) return;

					const description = typeof repo.description === 'string' && repo.description.trim().length >= 4
						? repo.description.trim()
						: null;
					const descriptionNode = card.querySelector<HTMLElement>('[data-project-description]');
					if (description && descriptionNode) descriptionNode.textContent = description;
					const stars = card.querySelector<HTMLElement>('[data-project-stars]');
					const forks = card.querySelector<HTMLElement>('[data-project-forks]');
					if (stars) stars.textContent = String(Math.max(0, Number(repo.stargazers_count) || 0));
					if (forks) forks.textContent = String(Math.max(0, Number(repo.forks_count) || 0));

					const tags = card.querySelector<HTMLElement>('[data-project-tags]');
					if (tags && repo.language && !Array.from(tags.children).some((tag) => tag.textContent === repo.language)) {
						const languageTag = document.createElement('span');
						languageTag.className = 'inline-flex items-center rounded-md bg-zinc-100 px-2 py-1 text-xs text-zinc-600 dark:bg-zinc-900 dark:text-zinc-300';
						languageTag.textContent = repo.language;
						tags.prepend(languageTag);
						while (tags.children.length > 3) tags.lastElementChild?.remove();
					}

					const repositoryLink = card.querySelector<HTMLAnchorElement>('[data-project-repository]');
					const repositoryUrl = safeExternalUrl(repo.html_url);
					if (repositoryLink && repositoryUrl) repositoryLink.href = repositoryUrl;
					const homepageLink = card.querySelector<HTMLAnchorElement>('[data-project-homepage]');
					const homepageUrl = safeExternalUrl(repo.homepage);
					if (homepageLink && homepageUrl && homepageUrl !== repositoryUrl) {
						homepageLink.href = homepageUrl;
						homepageLink.classList.remove('hidden');
					}

					const updated = card.querySelector<HTMLElement>('[data-project-updated]');
					const updatedDate = repo.updated_at ? new Date(repo.updated_at) : null;
					if (updated && updatedDate && !Number.isNaN(updatedDate.valueOf())) {
						updated.textContent = `Updated ${updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}`;
					}
					const status = card.querySelector<HTMLElement>('[data-project-sync-status]');
					if (status) status.textContent = source === 'live' ? 'Live from GitHub' : 'GitHub cached';

					// Mark as matched so we don't add it again
					byName.delete(repoName!);
				});

				// Add dynamic cards for new repos not in the static list
				const root = document.querySelector<HTMLElement>('[data-github-projects]');
				if (root) {
					const newRepos = Array.from(byName.values())
						.sort((a, b) => new Date(b.updated_at || 0).getTime() - new Date(a.updated_at || 0).getTime());

					newRepos.forEach((repo, idx) => {
						const repoUrl = safeExternalUrl(repo.html_url) || `https://github.com/wublinux/${repo.name}`;
						const description = typeof repo.description === 'string' && repo.description.trim().length >= 4
							? repo.description.trim()
							: 'No description provided.';
						const language = repo.language || '';
						const updatedDate = repo.updated_at ? new Date(repo.updated_at) : null;
						const updatedStr = updatedDate && !Number.isNaN(updatedDate.valueOf())
							? `Updated ${updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}`
							: '';

						const card = document.createElement('article');
						card.className = 'card-spotlight group relative flex min-h-[260px] flex-col rounded-2xl border border-zinc-200 bg-white/95 p-6 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-zinc-300 hover:shadow-md dark:border-zinc-800 dark:bg-zinc-950/85 dark:hover:border-zinc-600';
						card.setAttribute('data-reveal', '');
						card.style.setProperty('--reveal-delay', `${(idx % 2) * 70}ms`);

						card.innerHTML = `
							<div class="flex items-start justify-between gap-3">
								<div class="flex items-center gap-3">
									<span class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-zinc-200 bg-zinc-100 text-zinc-700 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200">
										<svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.24c-3.23.7-3.91-1.37-3.91-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.26 3.38.97.1-.75.4-1.27.74-1.56-2.58-.3-5.29-1.29-5.29-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.47.11-3.05 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.4-2.72 5.38-5.3 5.67.42.36.79 1.06.79 2.14v3.17c0 .31.21.67.79.56A11.5 11.5 0 0 0 12 .7Z" /></svg>
									</span>
									<h3 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">${repo.name}</h3>
								</div>
								<span class="rounded-full border border-blue-200 bg-blue-50 px-2.5 py-1 text-[11px] font-medium text-blue-700 dark:border-blue-900 dark:bg-blue-950/50 dark:text-blue-300">${source === 'live' ? 'Live from GitHub' : 'GitHub cached'}</span>
							</div>
							<p class="mt-4 flex-1 text-sm leading-6 text-zinc-600 dark:text-zinc-300">${description}</p>
							<div class="mt-4 flex flex-wrap gap-2">
								${language ? `<span class="inline-flex items-center rounded-md bg-zinc-100 px-2 py-1 text-xs text-zinc-600 dark:bg-zinc-900 dark:text-zinc-300">${language}</span>` : ''}
							</div>
							<div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-zinc-100 pt-4 text-xs text-zinc-500 dark:border-zinc-800 dark:text-zinc-400">
								<div class="flex items-center gap-3">
									<span>★ ${repo.stargazers_count || 0}</span>
									<span>⑂ ${repo.forks_count || 0}</span>
									<span>${updatedStr}</span>
								</div>
								<div class="flex items-center gap-2">
									<a href="${repoUrl}" target="_blank" rel="noreferrer" class="font-medium text-zinc-700 no-underline hover:text-[rgb(180,126,36)] dark:text-zinc-200 dark:hover:text-[rgb(226,190,110)]">Repository ↗</a>
									${repo.homepage && safeExternalUrl(repo.homepage) ? `<a href="${safeExternalUrl(repo.homepage)}" target="_blank" rel="noreferrer" class="font-medium text-zinc-700 no-underline hover:text-[rgb(180,126,36)] dark:text-zinc-200 dark:hover:text-[rgb(226,190,110)]">Website ↗</a>` : ''}
								</div>
							</div>
						`;

						root.appendChild(card);
					});
				}
			}

			async function initGitHubProjects() {
				const root = document.querySelector<HTMLElement>('[data-github-projects]');
				if (!root || root.dataset.syncState === 'loading' || root.dataset.syncState === 'done') return;
				root.dataset.syncState = 'loading';

				const cached = readProjectCache();
				if (cached) {
					applyGitHubProjects(cached, 'cache');
					root.dataset.syncState = 'done';
					return;
				}

				const controller = new AbortController();
				const timeout = window.setTimeout(() => controller.abort(), 6500);
				try {
					const response = await fetch('https://api.github.com/users/wublinux/repos?per_page=100&sort=updated', {
						headers: { Accept: 'application/vnd.github+json' },
						signal: controller.signal,
					});
					if (!response.ok) throw new Error(`GitHub request failed: ${response.status}`);
					const data = await response.json();
					if (!Array.isArray(data)) throw new Error('GitHub response was not a repository list');
					writeProjectCache(data);
					applyGitHubProjects(data, 'live');
				} catch {
					// Static fallback cards remain usable when GitHub is unavailable or rate-limited.
				} finally {
					window.clearTimeout(timeout);
					root.dataset.syncState = 'done';
				}
			}

			function initFriends() {
				const prevButton = document.querySelector<HTMLButtonElement>('[data-friends-prev]');
				const nextButton = document.querySelector<HTMLButtonElement>('[data-friends-next]');
				const status = document.querySelector<HTMLElement>('[data-friends-pagination-status]');
				const grid = document.querySelector<HTMLElement>('[data-friends-grid]');
				const storePages = Array.from(document.querySelectorAll('[data-friends-store-page]'));
				if (!prevButton || !nextButton || !status || !grid || !storePages.length) return;
				if (grid.dataset.friendsBound === 'true') return;
				grid.dataset.friendsBound = 'true';

				let currentPage = 0;
				let isTransitioning = false;
				const lastPage = storePages.length - 1;
				const animationDuration = 170;

				const pageMarkup = (pageIndex: number) => {
					const source = storePages[pageIndex];
					return source ? source.innerHTML : '';
				};

				const syncButtons = () => {
					const hasMultiplePages = storePages.length > 1;
					const prevDisabled = isTransitioning || currentPage === 0 || !hasMultiplePages;
					const nextDisabled = isTransitioning || currentPage === lastPage || !hasMultiplePages;
					const prevVisible = currentPage > 0 && hasMultiplePages;

					prevButton.classList.toggle('pointer-events-none', prevDisabled);
					prevButton.classList.toggle('opacity-50', prevDisabled);
					prevButton.classList.toggle('is-hidden', !prevVisible);
					prevButton.setAttribute('aria-hidden', String(!prevVisible));
					nextButton.classList.toggle('pointer-events-none', nextDisabled);
					nextButton.classList.toggle('opacity-50', nextDisabled);
					status.textContent = `${currentPage + 1} / ${storePages.length}`;
				};

				const switchPage = (targetPage: number) => {
					if (isTransitioning) return;
					if (targetPage < 0 || targetPage > lastPage || targetPage === currentPage) return;

					isTransitioning = true;
					syncButtons();

					grid.style.transform = 'translateY(4px)';
					grid.classList.remove('opacity-100');
					grid.classList.add('opacity-0');

					window.setTimeout(() => {
						grid.innerHTML = pageMarkup(targetPage);
						currentPage = targetPage;
						syncButtons();

						requestAnimationFrame(() => {
							grid.style.transform = 'translateY(0)';
							grid.classList.remove('opacity-0');
							grid.classList.add('opacity-100');
						});

						window.setTimeout(() => {
							isTransitioning = false;
							syncButtons();
						}, animationDuration);
					}, animationDuration);
				};

				prevButton.addEventListener('click', () => {
					switchPage(currentPage - 1);
				});

				nextButton.addEventListener('click', () => {
					switchPage(currentPage + 1);
				});

				grid.innerHTML = pageMarkup(0);
				grid.style.transform = 'translateY(0)';
				grid.classList.remove('opacity-0');
				grid.classList.add('opacity-100');
				syncButtons();
			}

			// Initialize on page load
			initFriends();
			initGitHubProjects();

			// Re-initialize on View Transitions
			document.addEventListener('astro:page-load', initFriends);
			document.addEventListener('astro:page-load', initGitHubProjects);
		</script>
		<style>
			.friends-pager {
				overflow: clip;
			}

			.friends-pager-button {
				transform-origin: center;
			}

			.friends-pager-button.is-hidden {
				opacity: 0;
				max-width: 0;
				min-width: 0;
				padding-inline: 0;
				margin-inline: 0;
				overflow: hidden;
				transform: translateX(-6px) scale(0.96);
				pointer-events: none;
			}

			.friends-desc-clamp {
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			@media (prefers-reduced-motion: reduce) {
				.friends-pager-button {
					transition: none !important;
					transform: none !important;
				}
			}
		</style>
	</body>
</html>
