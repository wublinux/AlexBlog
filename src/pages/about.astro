---
import Layout from '../layouts/BlogPost.astro';
import SakuraSpiral from '../components/SakuraSpiral.astro';
import SakuraFaller from '../components/SakuraFaller.astro';
import TerminalQuote from '../components/TerminalQuote.astro';

const nowText = 'Now: Building things, learning constantly, and documenting the process.';
---

<Layout
	title="About Me - Alex Huang"
	description="Learn more about Alex Huang, a developer passionate about technology, learning, and building practical systems."
	pubDate={new Date('Jul 03 2026')}
	metaMode="page"
>
	<Fragment slot="background">
		<SakuraSpiral />
		<SakuraFaller density={1.8} heightVh={60} />
	</Fragment>
	<div class="mx-auto max-w-3xl">
		<p>
			I am Alex Huang, a developer who cares about practical engineering, clear reasoning,
			and building systems that work. This blog is my long-term notebook for experiments,
			tools, and technical decisions.
		</p>

		<h2>Focus</h2>
		<ul>
			<li>Software engineering and system design: web development, tooling, and reproducible workflows</li>
			<li>AI and applied systems: LLM tooling, automation, and intelligent workflows</li>
			<li>Continuous learning: exploring new technologies and documenting the journey</li>
		</ul>

		<h2>Now</h2>
		<div class="mx-auto max-w-2xl text-left">
			<TerminalQuote text={nowText} once={true} fixedHeight={false} />
		</div>

		<h2>Contact</h2>
		<p>
			The best way to reach me is via
			<a href="https://github.com/wublinux" target="_blank" rel="noreferrer">GitHub</a>.
		</p>
	</div>
</Layout>
