---
/*
 * Zero-backend static full-text search modal powered by Pagefind.
 * Uses native <dialog> top-layer rendering, lazy-loads /pagefind/pagefind.js
 * on first use, supports Cmd/Ctrl+K and keyboard navigation, and renders
 * excerpts safely without raw innerHTML injection.
 */
---

<dialog
	id="site-search-dialog"
	class="site-search-dialog m-auto w-[min(92vw,38rem)] overflow-hidden rounded-2xl border border-zinc-200/85 bg-white/94 p-0 text-zinc-900 shadow-[0_28px_80px_rgba(15,23,42,0.22)] backdrop-blur-2xl dark:border-zinc-700/85 dark:bg-zinc-900/94 dark:text-zinc-100 dark:shadow-[0_28px_80px_rgba(0,0,0,0.55)]"
	aria-label="Search site"
	data-pagefind-ignore
>
	<div class="flex flex-col">
		<div class="flex items-center gap-3 border-b border-zinc-200/80 px-4 py-3.5 dark:border-zinc-800/80">
			<svg
				viewBox="0 0 24 24"
				class="h-4 w-4 shrink-0 text-zinc-400 dark:text-zinc-500"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				aria-hidden="true"
			>
				<circle cx="11" cy="11" r="7" />
				<path d="m20 20-3.5-3.5" stroke-linecap="round" />
			</svg>
			<input
				id="site-search-input"
				type="search"
				placeholder="Search articles, notes, tags..."
				autocomplete="off"
				spellcheck="false"
				class="min-w-0 flex-1 bg-transparent font-sans text-[15px] text-zinc-900 outline-none placeholder:text-zinc-400 dark:text-zinc-100 dark:placeholder:text-zinc-500"
			/>
			<button
				type="button"
				id="site-search-close"
				class="inline-flex items-center rounded-md border border-zinc-200/85 px-1.5 py-0.5 font-mono text-[11px] font-medium text-zinc-500 transition-colors hover:border-zinc-300 hover:text-zinc-800 dark:border-zinc-700/85 dark:text-zinc-400 dark:hover:border-zinc-600 dark:hover:text-zinc-200"
				aria-label="Close search"
			>
				ESC
			</button>
		</div>

		<div
			id="site-search-results"
			class="max-h-[min(62vh,26rem)] overflow-y-auto px-2 py-2"
			role="listbox"
			aria-label="Search results"
		>
			<p class="px-3 py-8 text-center text-sm text-zinc-500 dark:text-zinc-400">
				Type to search across all published posts.
			</p>
		</div>

		<div class="flex items-center justify-between border-t border-zinc-200/75 px-4 py-2.5 text-[11px] text-zinc-400 dark:border-zinc-800/75 dark:text-zinc-500">
			<div class="flex items-center gap-3 font-mono">
				<span>↑↓ navigate</span>
				<span>↵ open</span>
			</div>
			<span class="font-mono">Pagefind</span>
		</div>
	</div>
</dialog>

<style is:global>
	.site-search-dialog::backdrop {
		background: rgba(15, 23, 42, 0.36);
		backdrop-filter: blur(6px);
	}

	html.dark .site-search-dialog::backdrop {
		background: rgba(0, 0, 0, 0.58);
	}

	.site-search-dialog[open] {
		animation: search-dialog-in 170ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	@keyframes search-dialog-in {
		from {
			opacity: 0;
			transform: translateY(-8px) scale(0.985);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	.site-search-result {
		display: block;
		border-radius: 0.75rem;
		padding: 0.75rem 0.85rem;
		text-decoration: none;
		color: inherit;
		border: 1px solid transparent;
		transition: background-color 140ms ease, border-color 140ms ease;
	}

	.site-search-result:hover,
	.site-search-result[aria-selected='true'] {
		background: rgba(244, 244, 245, 0.92);
		border-color: rgba(228, 228, 231, 0.95);
	}

	html.dark .site-search-result:hover,
	html.dark .site-search-result[aria-selected='true'] {
		background: rgba(39, 39, 42, 0.88);
		border-color: rgba(63, 63, 70, 0.95);
	}

	.site-search-excerpt mark {
		background: rgba(250, 204, 21, 0.28);
		color: inherit;
		border-radius: 0.25rem;
		padding: 0 0.18rem;
		font-weight: 600;
	}

	html.dark .site-search-excerpt mark {
		background: rgba(234, 179, 8, 0.26);
		color: rgb(254 240 138);
	}

	@media (prefers-reduced-motion: reduce) {
		.site-search-dialog[open] {
			animation: none;
		}
	}
</style>

<script>
	interface PagefindResultData {
		url: string;
		excerpt: string;
		meta?: { title?: string };
	}

	interface PagefindSearchResponse {
		results: Array<{ data: () => Promise<PagefindResultData> }>;
	}

	interface PagefindModule {
		init?: () => Promise<void>;
		search: (query: string) => Promise<PagefindSearchResponse>;
	}

	(() => {
		const win = window as any;

		// Shared lazy Pagefind loader so SearchModal and InteractiveTerminal reuse one instance.
		if (!win.__loadPagefind) {
			let loaderPromise: Promise<PagefindModule | null> | null = null;
			win.__loadPagefind = (): Promise<PagefindModule | null> => {
				if (!loaderPromise) {
					loaderPromise = (async () => {
						try {
							const pagefindPath = '/pagefind/pagefind.js';
							const mod = (await import(/* @vite-ignore */ pagefindPath)) as PagefindModule;
							if (typeof mod.init === 'function') {
								await mod.init();
							}
							return mod;
						} catch {
							return null;
						}
					})();
				}
				return loaderPromise;
			};
		}

		// Parse Pagefind excerpt safely into text + <mark> nodes only (no raw innerHTML).
		const appendSafeExcerpt = (target: HTMLElement, excerptHtml: string) => {
			target.textContent = '';
			const doc = new DOMParser().parseFromString(`<div>${excerptHtml}</div>`, 'text/html');
			const container = doc.body.firstElementChild;
			if (!container) {
				target.textContent = excerptHtml;
				return;
			}
			const walk = (node: Node, out: HTMLElement) => {
				if (node.nodeType === Node.TEXT_NODE) {
					out.appendChild(document.createTextNode(node.textContent || ''));
					return;
				}
				if (node.nodeType === Node.ELEMENT_NODE) {
					const el = node as Element;
					if (el.tagName.toLowerCase() === 'mark') {
						const mark = document.createElement('mark');
						mark.textContent = el.textContent || '';
						out.appendChild(mark);
					} else {
						for (const child of Array.from(el.childNodes)) {
							walk(child, out);
						}
					}
				}
			};
			for (const child of Array.from(container.childNodes)) {
				walk(child, target);
			}
		};

		const safeLocalUrl = (rawUrl: string): string => {
			try {
				const parsed = new URL(rawUrl, window.location.origin);
				if (parsed.origin !== window.location.origin) return '/';
				if (parsed.pathname.startsWith('/admin/')) return '/';
				return `${parsed.pathname}${parsed.search}${parsed.hash}`;
			} catch {
				return '/';
			}
		};

		const renderMessage = (container: HTMLElement, text: string) => {
			container.textContent = '';
			const p = document.createElement('p');
			p.className = 'px-3 py-8 text-center text-sm text-zinc-500 dark:text-zinc-400';
			p.textContent = text;
			container.appendChild(p);
		};

		const initSearchModal = () => {
			const dialog = document.getElementById('site-search-dialog') as HTMLDialogElement | null;
			const input = document.getElementById('site-search-input') as HTMLInputElement | null;
			const resultsEl = document.getElementById('site-search-results') as HTMLElement | null;
			const closeBtn = document.getElementById('site-search-close');
			const triggers = Array.from(document.querySelectorAll('[data-search-trigger]'));

			if (!dialog || !input || !resultsEl) return;

			let activeIndex = -1;
			let debounceTimer = 0;
			let latestQuery = '';

			const updateSelection = (nextIndex: number) => {
				const items = Array.from(resultsEl.querySelectorAll<HTMLAnchorElement>('.site-search-result'));
				if (!items.length) {
					activeIndex = -1;
					return;
				}
				activeIndex = ((nextIndex % items.length) + items.length) % items.length;
				items.forEach((item, idx) => {
					const selected = idx === activeIndex;
					item.setAttribute('aria-selected', String(selected));
					if (selected) item.scrollIntoView({ block: 'nearest' });
				});
			};

			const openSearch = () => {
				if (!dialog.open) {
					dialog.showModal();
				}
				window.requestAnimationFrame(() => {
					input.focus();
					input.select();
				});
				void win.__loadPagefind?.();
			};

			const closeSearch = () => {
				if (dialog.open) dialog.close();
			};

			win.__openSiteSearch = openSearch;

			const runSearch = async (query: string) => {
				const trimmed = query.trim();
				latestQuery = trimmed;
				activeIndex = -1;

				if (!trimmed) {
					renderMessage(resultsEl, 'Type to search across all published posts.');
					return;
				}

				const pagefind = (await win.__loadPagefind?.()) as PagefindModule | null;
				if (latestQuery !== trimmed) return;

				if (!pagefind) {
					renderMessage(
						resultsEl,
						'Search index is generated on production builds (run npm run build && npm run preview).'
					);
					return;
				}

				const search = await pagefind.search(trimmed);
				if (latestQuery !== trimmed) return;

				const topResults = await Promise.all(search.results.slice(0, 8).map((r) => r.data()));
				if (latestQuery !== trimmed) return;

				if (!topResults.length) {
					renderMessage(resultsEl, `No results for "${trimmed}".`);
					return;
				}

				resultsEl.textContent = '';
				const frag = document.createDocumentFragment();

				topResults.forEach((item, idx) => {
					const link = document.createElement('a');
					link.href = safeLocalUrl(item.url);
					link.className = 'site-search-result';
					link.setAttribute('role', 'option');
					link.setAttribute('aria-selected', idx === 0 ? 'true' : 'false');

					const titleRow = document.createElement('div');
					titleRow.className = 'flex items-center justify-between gap-3';

					const titleEl = document.createElement('span');
					titleEl.className = 'truncate font-sans text-sm font-semibold text-zinc-900 dark:text-zinc-100';
					titleEl.textContent = item.meta?.title || link.pathname;

					const pathEl = document.createElement('span');
					pathEl.className = 'shrink-0 font-mono text-[11px] text-zinc-400 dark:text-zinc-500';
					pathEl.textContent = decodeURI(link.pathname);

					titleRow.appendChild(titleEl);
					titleRow.appendChild(pathEl);

					const excerptEl = document.createElement('p');
					excerptEl.className =
						'site-search-excerpt m-0 mt-1 line-clamp-2 text-xs leading-5 text-zinc-600 dark:text-zinc-400';
					appendSafeExcerpt(excerptEl, item.excerpt || '');

					link.appendChild(titleRow);
					link.appendChild(excerptEl);
					link.addEventListener('click', closeSearch);
					frag.appendChild(link);
				});

				resultsEl.appendChild(frag);
				activeIndex = 0;
			};

			triggers.forEach((btn) => {
				if ((btn as HTMLElement).dataset.searchBound === 'true') return;
				(btn as HTMLElement).dataset.searchBound = 'true';
				btn.addEventListener('click', openSearch);
			});

			if (dialog.dataset.searchBound !== 'true') {
				dialog.dataset.searchBound = 'true';

				closeBtn?.addEventListener('click', closeSearch);
				dialog.addEventListener('click', (event) => {
					if (event.target === dialog) closeSearch();
				});

				input.addEventListener('input', () => {
					window.clearTimeout(debounceTimer);
					debounceTimer = window.setTimeout(() => {
						void runSearch(input.value);
					}, 120);
				});

				input.addEventListener('keydown', (event) => {
					if (event.key === 'ArrowDown') {
						event.preventDefault();
						updateSelection(activeIndex + 1);
					} else if (event.key === 'ArrowUp') {
						event.preventDefault();
						updateSelection(activeIndex - 1);
					} else if (event.key === 'Enter') {
						const selected = resultsEl.querySelector<HTMLAnchorElement>(
							'.site-search-result[aria-selected="true"]'
						);
						if (selected) {
							event.preventDefault();
							closeSearch();
							selected.click();
						}
					}
				});
			}
		};

		if (!win.__searchKeybindBound) {
			win.__searchKeybindBound = true;
			document.addEventListener('keydown', (event) => {
				const target = event.target as HTMLElement | null;
				const isTyping =
					target &&
					(target.tagName === 'INPUT' ||
						target.tagName === 'TEXTAREA' ||
						target.tagName === 'SELECT' ||
						target.isContentEditable);

				if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
					event.preventDefault();
					const dialog = document.getElementById('site-search-dialog') as HTMLDialogElement | null;
					if (dialog?.open) dialog.close();
					else win.__openSiteSearch?.();
					return;
				}

				if (event.key === '/' && !isTyping && !event.metaKey && !event.ctrlKey && !event.altKey) {
					event.preventDefault();
					win.__openSiteSearch?.();
				}
			});
			document.addEventListener('astro:page-load', initSearchModal);
			document.addEventListener('astro:after-swap', initSearchModal);
		}

		initSearchModal();
	})();
</script>
