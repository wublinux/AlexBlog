---
/*
 * Sakura spiral background animation (About page).
 * Soft rotating sakura petals arranged in a gentle spiral,
 * creating a dreamy, anime-like atmosphere.
 * Decorative only: fixed, z-index -1, md+ only.
 */

const PETALS = 18;
const petals = [];
for (let i = 0; i < PETALS; i++) {
	const angle = (i / PETALS) * Math.PI * 2;
	const radius = 120 + i * 35;
	petals.push({
		cx: (800 + Math.cos(angle) * radius).toFixed(1),
		cy: (450 + Math.sin(angle) * radius).toFixed(1),
		rotation: (angle * 180 / Math.PI).toFixed(1),
		size: (12 + i * 0.8).toFixed(1),
		delay: (i * 0.15).toFixed(2),
		opacity: Math.max(0.08, 0.4 - i * 0.018).toFixed(3),
	});
}
---

<div class="sakura-spiral-layer" aria-hidden="true">
	<svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
		<g class="sakura-spiral-rotate" style="transform-origin: 800px 450px">
			{petals.map((p, i) => (
				<g transform={`translate(${p.cx}, ${p.cy}) rotate(${p.rotation})`} style={`animation-delay: ${p.delay}s`}>
					<ellipse
						class="sakura-petal"
						rx={p.size}
						ry={String(Number(p.size) * 0.65)}
						vector-effect="non-scaling-stroke"
					/>
				</g>
			))}
		</g>
	</svg>
</div>

<style is:global>
	.sakura-spiral-layer {
		position: fixed;
		inset: 0;
		z-index: -1;
		display: none;
		pointer-events: none;
		user-select: none;
		opacity: 0.85;
	}

	@media (min-width: 768px) {
		.sakura-spiral-layer {
			display: block;
		}
	}

	.sakura-spiral-layer svg {
		width: 100%;
		height: 100%;
		display: block;
	}

	.sakura-spiral-rotate {
		transform-box: view-box;
		animation: sakura-spiral-spin 60s linear infinite;
	}

	.sakura-petal {
		fill: none;
		stroke: rgba(255, 183, 197, 0.3);
		stroke-width: 1.2;
		stroke-linecap: round;
		stroke-dasharray: 60;
		stroke-dashoffset: 60;
		animation: sakura-petal-draw 1200ms cubic-bezier(0.45, 0, 0.3, 1) both;
	}

	html.dark .sakura-petal {
		stroke: rgba(255, 209, 220, 0.25);
	}

	@keyframes sakura-petal-draw {
		to {
			stroke-dashoffset: 0;
		}
	}

	@keyframes sakura-spiral-spin {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.sakura-spiral-rotate {
			animation: none !important;
		}

		.sakura-petal {
			animation: none !important;
			stroke-dashoffset: 0 !important;
		}
	}
</style>
