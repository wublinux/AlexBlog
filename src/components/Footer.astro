---
/*
 * Global footer shared by every public page (never rendered on /admin/*).
 * Also hosts the persistent Pidan page companion so state survives route transitions.
 */
import ReadingPet from './ReadingPet.astro';

const today = new Date();
---

<footer class="mt-16 border-t border-zinc-200 py-8 transition-colors duration-200 dark:border-zinc-800" data-pagefind-ignore>
	<div class="page-shell flex flex-col items-center justify-between gap-4 text-sm text-zinc-500 dark:text-zinc-400 md:flex-row">
		<p class="m-0">&copy; {today.getFullYear()} Alex Huang. All rights reserved.</p>
	</div>
</footer>

<ReadingPet />
