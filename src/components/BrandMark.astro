---
/*
 * One-stroke signature "A" — the site's brand mark for Alex's Blog.
 * A single continuous path drawing the letter A with a flourish,
 * animated with a stroke-dash at load and replayed on hover.
 * Designed at 120x100; path length ≈ 330 (see brand-draw keyframes).
 */
interface Props {
	class?: string;
}
const { class: className } = Astro.props as Props;
---

<svg
	class:list={['brand-mark', className]}
	viewBox="0 0 120 100"
	fill="none"
	xmlns="http://www.w3.org/2000/svg"
	aria-hidden="true"
>
	<defs>
		<linearGradient id="brand-mark-gold" x1="0" y1="0" x2="1" y2="1">
			<stop offset="0" stop-color="#c25b78"></stop>
			<stop offset="0.55" stop-color="#ffd1dc"></stop>
			<stop offset="1" stop-color="#8b3a5e"></stop>
		</linearGradient>
		<linearGradient id="brand-mark-gold-dark" x1="0" y1="0" x2="1" y2="1">
			<stop offset="0" stop-color="#ffe6f0"></stop>
			<stop offset="0.55" stop-color="#ffb3c6"></stop>
			<stop offset="1" stop-color="#fff0f5"></stop>
		</linearGradient>
	</defs>
	<path
		class="brand-mark-path"
		d="M 22 88 C 26 72, 34 48, 42 28 C 48 14, 54 8, 60 10 C 66 12, 70 22, 76 40 C 82 56, 88 72, 96 88 M 38 60 C 48 58, 60 56, 72 58 C 78 59, 86 62, 92 66"
		stroke="url(#brand-mark-gold)"></path>
</svg>
