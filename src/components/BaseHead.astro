---
/*
 * Shared document head for every route.
 * Centralizes metadata, self-hosted fonts, Speculation Rules, structured data,
 * CSP hashes for blocking inline tags, and bundled polish scripts.
 */
import '../styles/global.css';
import { createHash } from 'node:crypto';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import type { ImageMetadata } from 'astro';
import { SITE_TITLE } from '../consts';
import { serializeJsonLd } from '../utils/seo';

interface AlternateLink {
	hreflang: string;
	href: string;
}

interface Props {
	// Human-readable page title used by document title and social metadata.
	title: string;
	// Summary used by search/social cards and meta description.
	description: string;
	// Optional social preview image; falls back to the branded OG card.
	image?: ImageMetadata | string;
	imageAlt?: string;
	ogType?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	tags?: string[];
	author?: string;
	alternates?: AlternateLink[];
	markdownAlternate?: string;
	jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image,
	imageAlt,
	ogType = 'website',
	publishedTime,
	modifiedTime,
	tags = [],
	author,
	alternates = [],
	markdownAlternate,
	jsonLd,
} = Astro.props;

const BASE = import.meta.env.BASE_URL;
const usesDefaultOgImage = !image;
const ogImagePath = typeof image === 'string' ? image : image?.src ?? `${BASE}image/og-default.png`;
const ogImageURL = new URL(ogImagePath, Astro.site ?? Astro.url);
const hasStandardOgDimensions =
	usesDefaultOgImage || (typeof image === 'string' && image.includes('/og/') && image.endsWith('.png'));
const resolvedImageAlt = imageAlt ?? (usesDefaultOgImage ? "Alex's Blog — Tech · Notes · Life" : title);
const cfWebAnalyticsToken = import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN;
const serializedJsonLd = jsonLd ? serializeJsonLd(jsonLd) : null;

const THEME_INIT_SCRIPT =
	"(()=>{const k='theme',r=document.documentElement,s=localStorage.getItem(k),d=window.matchMedia('(prefers-color-scheme: dark)').matches,t=s==='dark'||s==='light'?s:d?'dark':'light';r.classList.toggle('dark',t==='dark');r.dataset.theme=t;window.__syncThemeColor=(isDark)=>{const m=document.querySelector('meta[name=\"theme-color\"]');if(m)m.setAttribute('content',isDark?'#09090b':'#fafafa');};window.__syncThemeColor(t==='dark');})();";

const SPECULATION_RULES_JSON = JSON.stringify({
	prefetch: [
		{
			source: 'document',
			where: {
				and: [
					{ href_matches: '/*' },
					{ not: { href_matches: '/admin/*' } },
					{ not: { href_matches: '/api/*' } },
					{ not: { href_matches: '/*.xml' } },
					{ not: { href_matches: '/*.md' } },
					{ not: { href_matches: '/*.txt' } },
					{ not: { href_matches: '/*.png' } },
					{ not: { selector_matches: '[download], [data-no-prerender]' } },
				],
			},
			eagerness: 'moderate',
		},
	],
	prerender: [
		{
			source: 'document',
			where: {
				and: [
					{ href_matches: '/blog/*' },
					{ not: { href_matches: '/blog/*.md' } },
					{ not: { selector_matches: '[download], [data-no-prerender]' } },
				],
			},
			eagerness: 'moderate',
		},
	],
});

const sha256Hash = (content: string) =>
	`sha256-${createHash('sha256').update(content, 'utf8').digest('base64')}` as const;

Astro.csp?.insertScriptHash(sha256Hash(THEME_INIT_SCRIPT));
Astro.csp?.insertScriptHash(sha256Hash(SPECULATION_RULES_JSON));
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<!-- Keep View Transitions globally enabled so only targeted links/routes opt out when needed. -->
<ClientRouter />
<!-- Favicon set generated from the original avatar (scripts/generate-brand-assets.mjs). -->
<link rel="icon" type="image/x-icon" href={`${BASE}image/favicon.ico`} />
<link rel="shortcut icon" href={`${BASE}image/favicon.ico`} />
<link rel="icon" type="image/png" sizes="32x32" href={`${BASE}image/favicon-32.png`} />
<link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
<link rel="apple-touch-icon" sizes="180x180" href={`${BASE}image/apple-touch-icon.png`} />
<link rel="sitemap" href={`${BASE}sitemap-index.xml`} />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={`${BASE}rss.xml`}
/>
{markdownAlternate && <link rel="alternate" type="text/markdown" title={title} href={markdownAlternate} />}
{alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
<meta name="generator" content={Astro.generator} />

<!-- Self-hosted fonts via Astro 7 Fonts API (zero external Google Fonts runtime dependency) -->
<Font cssVariable="--font-inter" preload />
<Font cssVariable="--font-instrument-serif" />
<Font cssVariable="--font-jetbrains-mono" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="google-site-verification" content="c9eLQFflOQPGAa5ykLn2PnyXDt5rup4VJNQe3P8hW7Y" />

<!-- Open Graph / Facebook / Discord -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
{hasStandardOgDimensions && <meta property="og:image:width" content="1200" />}
{hasStandardOgDimensions && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={resolvedImageAlt} />
{ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{ogType === 'article' && author && <meta property="article:author" content={author} />}
{ogType === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImageURL} />

<!-- Browser chrome tinting; kept in sync with the user-chosen theme by script. -->
<meta name="theme-color" content="#fafafa" />

{serializedJsonLd && <script type="application/ld+json" set:html={serializedJsonLd} />}

<!-- Conservative Speculation Rules for near-instant internal navigation (excludes /admin and /api). -->
<script type="speculationrules" is:inline set:html={SPECULATION_RULES_JSON} />

<!-- Apply theme before first paint to prevent light/dark flash (SHA-256 registered in Astro CSP). -->
<script is:inline set:html={THEME_INIT_SCRIPT} />

<script>
	(() => {
		const win = window as any;

		win.__formatCompactViewCount = (count: unknown) => {
			const v = Number(count);
			if (!Number.isFinite(v) || v < 0) return '0';
			if (v >= 1000) return `${(v / 1000).toFixed(v >= 10000 ? 0 : 1).replace(/\.0$/, '')}k`;
			return v.toLocaleString('en-US');
		};
		win.__formatFullViewCount = (count: unknown) => {
			const v = Number(count);
			if (!Number.isFinite(v) || v < 0) return '0 views';
			return `${v.toLocaleString('en-US')} ${v === 1 ? 'view' : 'views'}`;
		};

		// Custom cursor (fine pointer + motion allowed)
		if (!win.__cursorScriptInit) {
			win.__cursorScriptInit = true;

			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const supportsFinePointer = window.matchMedia('(pointer: fine)').matches;

			if (!prefersReducedMotion && supportsFinePointer) {
				let cursorEl: HTMLDivElement | null = null;
				let currentX = window.innerWidth / 2;
				let currentY = window.innerHeight / 2;
				let targetX = currentX;
				let targetY = currentY;
				let currentState = 'default';
				let isPressed = false;
				let hasPointerPosition = false;

				const TEXT_SELECTOR = [
					'p',
					'span',
					'strong',
					'em',
					'blockquote',
					'li',
					'h1',
					'h2',
					'h3',
					'h4',
					'h5',
					'h6',
					'figcaption',
					'td',
					'th',
					'summary',
					'label',
				].join(',');

				const CLICKABLE_SELECTOR = [
					'a',
					'button',
					'summary',
					'label',
					'input',
					'textarea',
					'select',
					'[role="button"]',
					'[role="tab"]',
					'.apple-float-chip',
					'.icon-button',
				].join(',');

				const applyCursorSuppression = () => {
					if (!document.documentElement.classList.contains('has-custom-cursor')) {
						document.documentElement.classList.add('has-custom-cursor');
					}
					if (document.documentElement.style.cursor !== 'none') {
						document.documentElement.style.cursor = 'none';
					}
					if (document.body && document.body.style.cursor !== 'none') {
						document.body.style.cursor = 'none';
					}
				};

				const ensureCursor = () => {
					if (cursorEl?.isConnected) return cursorEl;
					cursorEl = document.createElement('div');
					cursorEl.className = 'app-cursor';
					const target = document.body || document.documentElement;
					target.appendChild(cursorEl);
					applyCursorSuppression();
					return cursorEl;
				};

				const renderCursor = () => {
					const el = ensureCursor();
					el.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) translate(-50%, -50%)`;
				};

				const updateCursorClasses = () => {
					const el = ensureCursor();
					el.classList.toggle('is-visible', hasPointerPosition);
					el.classList.toggle('is-clickable', currentState === 'clickable');
					el.classList.toggle('is-text', currentState === 'text');
					el.classList.toggle('is-pressed', isPressed);
				};

				const isPointInsideRect = (x: number, y: number, rect: DOMRect) =>
					x >= rect.left && x <= rect.right && y >= rect.top && y <= rect.bottom;

				const isTextHit = (target: EventTarget | null, x: number, y: number) => {
					if (!(target instanceof Element)) return false;

					const textElement = target.closest(TEXT_SELECTOR);
					if (!textElement) return false;

					const doc = document as Document & {
						caretRangeFromPoint?: (x: number, y: number) => Range | null;
						caretPositionFromPoint?: (x: number, y: number) => { offsetNode?: Node } | null;
					};

					const caretRange = doc.caretRangeFromPoint?.(x, y);
					if (caretRange?.startContainer) {
						const node = caretRange.startContainer;
						const parentElement = node.nodeType === Node.TEXT_NODE ? node.parentElement : node;
						if (parentElement instanceof Element && parentElement.closest(TEXT_SELECTOR)) {
							return true;
						}
					}

					if (doc.caretPositionFromPoint) {
						const caretPosition = doc.caretPositionFromPoint(x, y);
						const node = caretPosition?.offsetNode;
						const parentElement = node?.nodeType === Node.TEXT_NODE ? node.parentElement : node;
						if (parentElement instanceof Element && parentElement.closest(TEXT_SELECTOR)) {
							return true;
						}
					}

					const range = document.createRange();
					const walker = document.createTreeWalker(textElement, NodeFilter.SHOW_TEXT, {
						acceptNode(node) {
							return node.textContent?.trim() ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
						},
					});

					let textNode = walker.nextNode();
					while (textNode) {
						range.selectNodeContents(textNode);
						const rects = range.getClientRects();
						for (const rect of rects) {
							if (isPointInsideRect(x, y, rect)) {
								return true;
							}
						}
						textNode = walker.nextNode();
					}

					return false;
				};

				const setStateFromTarget = (target: EventTarget | null, x = targetX, y = targetY) => {
					if (!(target instanceof Element)) {
						currentState = 'default';
						updateCursorClasses();
						return;
					}

					if (target.closest(CLICKABLE_SELECTOR)) {
						currentState = 'clickable';
					} else if (isTextHit(target, x, y)) {
						currentState = 'text';
					} else {
						currentState = 'default';
					}
					updateCursorClasses();
				};

				const initCursor = () => {
					applyCursorSuppression();
					ensureCursor();
					updateCursorClasses();
					renderCursor();
				};

				document.addEventListener(
					'pointermove',
					(event) => {
						if (event.pointerType && event.pointerType !== 'mouse') return;
						targetX = event.clientX;
						targetY = event.clientY;
						currentX = targetX;
						currentY = targetY;
						hasPointerPosition = true;
						initCursor();
						setStateFromTarget(event.target, event.clientX, event.clientY);
					},
					{ passive: true }
				);

				document.addEventListener(
					'pointerdown',
					(event) => {
						if (event.pointerType && event.pointerType !== 'mouse') return;
						isPressed = true;
						updateCursorClasses();
					},
					{ passive: true }
				);

				document.addEventListener(
					'pointerup',
					(event) => {
						if (event.pointerType && event.pointerType !== 'mouse') return;
						isPressed = false;
						updateCursorClasses();
					},
					{ passive: true }
				);

				document.addEventListener(
					'pointerover',
					(event) => {
						if (event.pointerType && event.pointerType !== 'mouse') return;
						setStateFromTarget(event.target, targetX, targetY);
					},
					{ passive: true }
				);

				document.addEventListener('pointerleave', () => {
					if (!cursorEl) return;
					hasPointerPosition = false;
					cursorEl.classList.remove('is-visible');
				});

				window.addEventListener('blur', () => {
					if (!cursorEl) return;
					hasPointerPosition = false;
					cursorEl.classList.remove('is-visible');
				});

				window.addEventListener('focus', () => {
					if (!cursorEl) return;
					applyCursorSuppression();
					updateCursorClasses();
				});

				document.addEventListener('astro:after-swap', () => {
					applyCursorSuppression();
					requestAnimationFrame(applyCursorSuppression);
					initCursor();
				});

				document.addEventListener('astro:page-load', () => {
					applyCursorSuppression();
					requestAnimationFrame(applyCursorSuppression);
					initCursor();
				});

				document.addEventListener('visibilitychange', () => {
					if (document.visibilityState === 'visible') {
						applyCursorSuppression();
					}
				});

				const cursorObserver = new MutationObserver(() => {
					applyCursorSuppression();
				});

				cursorObserver.observe(document.documentElement, {
					attributes: true,
					attributeFilter: ['class', 'style'],
				});

				if (document.body) {
					cursorObserver.observe(document.body, {
						attributes: true,
						attributeFilter: ['style', 'class'],
					});
				} else {
					document.addEventListener(
						'DOMContentLoaded',
						() => {
							applyCursorSuppression();
							if (!document.body) return;
							cursorObserver.observe(document.body, {
								attributes: true,
								attributeFilter: ['style', 'class'],
							});
						},
						{ once: true }
					);
				}

				initCursor();
			}
		}

		// Polish layer:
		// 1. Scroll-triggered reveal fallback ONLY when CSS animation-timeline: view() is unsupported
		// 2. Directional View Transition slide direction
		// 3. Pointer-tracking card spotlight
		if (!win.__polishScriptInit) {
			win.__polishScriptInit = true;

			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const supportsCssViewReveal =
				typeof CSS !== 'undefined' && typeof CSS.supports === 'function' && CSS.supports('animation-timeline', 'view()');

			if (!reducedMotion && !supportsCssViewReveal && 'IntersectionObserver' in window) {
				document.documentElement.classList.add('js-reveal');

				let observer: IntersectionObserver | null = null;
				const ensureObserver = () => {
					if (observer) return observer;
					observer = new IntersectionObserver(
						(entries) => {
							for (const entry of entries) {
								if (!entry.isIntersecting) continue;
								entry.target.classList.add('revealed');
								observer?.unobserve(entry.target);
							}
						},
						{ rootMargin: '0px 0px -7% 0px', threshold: 0.06 }
					);
					return observer;
				};

				const scanReveals = () => {
					document.documentElement.classList.add('js-reveal');
					const io = ensureObserver();
					const vh = window.innerHeight || document.documentElement.clientHeight || 0;
					document.querySelectorAll('[data-reveal]:not(.revealed)').forEach((el) => {
						const rect = el.getBoundingClientRect();
						if (rect.top < vh * 0.95 && rect.bottom > -1) {
							el.classList.add('revealed');
						} else {
							io.observe(el);
						}
					});
				};

				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', scanReveals, { once: true });
				} else {
					scanReveals();
				}
				document.addEventListener('astro:page-load', scanReveals);
				document.addEventListener('astro:after-swap', scanReveals);
			}

			// Directional page transitions: slide left/right based on nav order.
			{
				const NAV_ORDER: Record<string, number> = {
					'': 0,
					blog: 1,
					tags: 2,
					'github-daily': 3,
					links: 4,
					about: 5,
				};
				const segmentFor = (url: URL) => {
					const parts = url.pathname.split('/').filter(Boolean);
					return parts[0] || '';
				};

				document.addEventListener('astro:before-preparation', (event: any) => {
					const root = document.documentElement;
					delete root.dataset.navDir;
					try {
						const fromIdx = NAV_ORDER[segmentFor(event.from)];
						const toIdx = NAV_ORDER[segmentFor(event.to)];
						if (fromIdx === undefined || toIdx === undefined || fromIdx === toIdx) return;
						root.dataset.navDir = toIdx > fromIdx ? 'forward' : 'back';
					} catch {}
				});
			}

			if (window.matchMedia('(pointer: fine)').matches) {
				let rafId = 0;
				let lastEvent: PointerEvent | null = null;

				const applySpotlight = () => {
					rafId = 0;
					const event = lastEvent;
					if (!event) return;
					const card = event.target instanceof Element ? event.target.closest('.card-spotlight') : null;
					if (!(card instanceof HTMLElement)) return;
					const rect = card.getBoundingClientRect();
					card.style.setProperty('--spot-x', `${event.clientX - rect.left}px`);
					card.style.setProperty('--spot-y', `${event.clientY - rect.top}px`);
				};

				document.addEventListener(
					'pointermove',
					(event) => {
						if (event.pointerType && event.pointerType !== 'mouse') return;
						lastEvent = event;
						if (!rafId) rafId = requestAnimationFrame(applySpotlight);
					},
					{ passive: true }
				);
			}
		}
	})();
</script>
{
	import.meta.env.PROD && cfWebAnalyticsToken && (
		<script
			is:inline
			defer
			src="https://static.cloudflareinsights.com/beacon.min.js"
			data-cf-beacon={`{"token":"${cfWebAnalyticsToken}"}`}
		></script>
	)
}
